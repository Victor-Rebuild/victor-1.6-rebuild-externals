Name: AlexaClientSDK
Description: A cross-platform, modular SDK for interacting with the Alexa Voice Service
Version: 1.20.1
Requires: libcurl sqlite3
prefix=/home/raj-jyot/Vector/avs-build/install
includedir=${prefix}/include
libdir=${prefix}/lib
Libs: -L${libdir} -lacsdkAlerts -lacsdkAudioPlayer -lacsdkBluetooth -lacsdkDoNotDisturb -lacsdkMultiRoomMusic -lacsdkNotifications -lacsdkDefaultSampleApplicationOptions -lAVSCommon -lACL -lADSL -lAFML -lCaptions -lCaptionsLib -lacsdkCore -lAVSGatewayManager -lCertifiedSender -lEndpoints -lDeviceSettings -lEqualizerImplementations -lContextManager -lCapabilitiesDelegate -lInterruptModel -lPlaylistParser -lKWD -lAIP -lAlexa -lApiGateway -lEqualizer -lExternalMediaPlayer -lInteractionModel -lPlaybackController -lSoftwareComponentReporter -lSpeakerManager -lSpeechSynthesizer -lAVSSystem -lTemplateRuntime -lCBLAuthDelegate -lDefaultClient -lAudioResources -lSystemSoundPlayer -lSDKComponent -lRegistrationManager -lacsdkManufactory -lacsdkShared -lSpeechEncoder -lSQLiteStorage -lSynchronizeStateSender
Cflags: -I${includedir}
